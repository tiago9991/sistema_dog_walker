# Core settings
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Localization
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# Database
# Leave empty to use local SQLite. Example (local PostgreSQL in Docker
# Compose — see docs/banco.md; prefer 127.0.0.1 over localhost to avoid
# the Docker Desktop/Windows IPv6 loopback hang):
#   postgres://scsi:password@127.0.0.1:5432/scsi
DATABASE_URL=

# Celery (PRD section 18 — Sprint 11)
# Broker (RabbitMQ). Leave empty to run tasks synchronously (eager) —
# useful for quick host runs without RabbitMQ. Docker Compose overrides
# this to amqp://scsi:scsi@rabbitmq:5672// inside its own network.
CELERY_BROKER_URL=

# Cache / Celery result backend (Redis). Leave empty to use the local
# in-memory cache (quick host runs). Docker Compose overrides this to
# redis://redis:6379/0.
REDIS_URL=

# External services — AI (PRD sections 19 and 38 — Sprint 12; see docs/ia.md)
# Chat model: LangChain + OpenAI. Without a key the AI features report
# "not configured" — nothing else breaks.
OPENAI_API_KEY=
# PRD section 7: GPT-5.5-mini via OpenAI. Change only if the stack
# definition changes.
AI_MODEL=gpt-5.5-mini
